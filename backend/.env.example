# ---------------------------------------------------------------------------
# QTXpert.ai Test Design Agent - environment configuration template
# Copy to .env for local development. In Render, set these as real
# environment variables / secrets instead of committing a .env file.
# ---------------------------------------------------------------------------

# General
APP_NAME=QTXpert.ai Test Design Agent
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
POSTGRES_URL=postgresql+asyncpg://qtxpert:qtxpert@localhost:5432/qtxpert
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=60
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=300
DB_CLOSE_TIMEOUT_SECONDS=5
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Set a long random value temporarily only when bootstrapping the first admin.
# Remove it after /auth/bootstrap-admin succeeds. Never commit a real value.
ADMIN_BOOTSTRAP_TOKEN=

# Microsoft Entra ID (optional SSO)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# LLM provider selection. "router" is the cost-first default; a concrete
# provider preserves the previous single-provider behavior.
LLM_PROVIDER=router
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT_SECONDS=75
LLM_REASONING_EFFORT=low
LLM_MAX_RETRIES=2

# Router routes use provider:model, in preference order. Remove routes for
# providers you do not configure. Azure model values are deployment names.
LLM_ROUTER_LOW_COST=gemini:gemini-2.5-flash-lite,azure_openai:configured
LLM_ROUTER_STANDARD=gemini:gemini-2.5-flash,azure_openai:configured
LLM_ROUTER_COMPLEX=azure_openai:configured
LLM_ROUTER_FALLBACK=azure_openai:configured
LLM_ROUTER_COMPLEX_INPUT_CHARS=30000
# Optional per-million-token rates used only for QTXpert's estimated metering.
LLM_COST_RATES_JSON={"gemini:gemini-2.5-flash-lite":{"input":0.10,"output":0.40},"gemini:gemini-2.5-flash":{"input":0.30,"output":2.50}}

OPENAI_API_KEY=

AZURE_OPENAI_API_KEY=
AZURE_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Optional Azure Cost Management reconciliation for the Admin dashboard.
# Use a dedicated Entra app/service principal with Cost Management Reader (or
# equivalent read permission) at the resource-group/subscription scope.
# Keep the client secret in Render secrets; never commit a real value.
AZURE_COST_TENANT_ID=
AZURE_COST_CLIENT_ID=
AZURE_COST_CLIENT_SECRET=
AZURE_COST_SUBSCRIPTION_ID=
AZURE_COST_RESOURCE_GROUP=
# Optional when the resource can be derived from AZURE_ENDPOINT.
AZURE_COST_RESOURCE_NAME=
AZURE_COST_API_VERSION=2026-06-01
AZURE_COST_TIMEOUT_SECONDS=15

ANTHROPIC_API_KEY=

GOOGLE_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Optional AWS CloudWatch Application Signals / X-Ray APM. Disabled by
# default. When enabled, the container uses the AWS Distro for OpenTelemetry
# auto-instrumenter and the AWS SDK credential chain. Never commit real keys.
AWS_APM_ENABLED=false
AWS_APM_SERVICE_NAME=qtxpert-backend
AWS_APM_ENVIRONMENT=local
AWS_APM_TRACE_SAMPLE_RATIO=0.05
# CloudWatch log group and stream must already exist before enabling log export.
AWS_APM_LOG_GROUP=
AWS_APM_LOG_STREAM=
# Optional endpoint overrides; otherwise they are derived from AWS_REGION.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# Vector database (modular; leave provider=none to disable)
VECTOR_DB_PROVIDER=none
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=qtxpert-requirements

# Jira integration (OAuth2)
JIRA_URL=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

# Confluence integration (OAuth2)
CONFLUENCE_URL=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CONFLUENCE_REDIRECT_URI=

# File upload / generation safeguards
MAX_UPLOAD_SIZE_MB=25
MAX_REQUIREMENT_TEXT_CHARS=200000
MAX_REQUIREMENTS_PER_GENERATION=20
MAX_SCENARIOS_PER_GENERATION=40
GENERATION_STALE_AFTER_SECONDS=300
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt,md,json,csv,apk,ipa,zip,mp4,mov,webm
UPLOAD_STORAGE_PATH=./storage/uploads
# Durable artifact storage. Keep postgres_chunks while migrating existing data;
# switch to object_store after an S3-compatible bucket (Cloudflare R2, Amazon S3,
# MinIO, etc.) is configured in Render. Object-store credentials are secrets.
UPLOAD_STORAGE_BACKEND=postgres_chunks
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=qtxpert
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_MULTIPART_THRESHOLD_MB=16
OBJECT_STORAGE_PART_SIZE_MB=16

# Mobile Autopilot prototype
AUTOPILOT_MAX_UPLOAD_SIZE_MB=300
AUTOPILOT_DB_RETRY_ATTEMPTS=2
AUTOPILOT_DB_RETRY_BACKOFF_SECONDS=0.25
AUTOPILOT_DEEP_PARSE_MAX_MB=64
AUTOPILOT_LOCAL_STAGING_TTL_SECONDS=3600
AUTOPILOT_STORAGE_PATH=./storage/autopilot
AUTOPILOT_DISCOVERY_TIMEOUT_SECONDS=600
AUTOPILOT_SUITE_TIMEOUT_SECONDS=900
AUTOPILOT_DISCOVERY_SETTLE_SECONDS=4
AUTOPILOT_DISCOVERY_SETTLE_RETRIES=3
# Optional explicit Fernet key for encrypted Autopilot checkpoint inputs.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If blank, the service derives a key from JWT_SECRET (existing deployments remain compatible).
AUTOPILOT_INPUT_ENCRYPTION_KEY=
AUTOPILOT_INPUT_SESSION_TTL_SECONDS=3600
AUTOPILOT_INPUT_SAVED_TTL_DAYS=90

# Generated-data retention is disabled by default. Review the admin preview
# before running cleanup; the policy removes data older than seven days while
# keeping the three newest records per project/module. Source documents and
# APK/IPA assets are preserved; only ephemeral test/evidence assets qualify.
DATA_RETENTION_ENABLED=false
DATA_RETENTION_DAYS=7
DATA_RETENTION_KEEP_LATEST=3
DATA_RETENTION_INCLUDE_EPHEMERAL_ASSETS=true
DATA_RETENTION_RUN_ON_STARTUP=false

# Cost Center catalog. The catalog links/limits work without these optional
# secrets; configured connectors add account-specific plan and usage values.
COST_CENTER_AUTO_REFRESH_ENABLED=true
COST_CENTER_REFRESH_DAYS=30
COST_CENTER_REFRESH_TIMEOUT_SECONDS=8
NEON_API_KEY=
NEON_ORG_ID=
NEON_PLAN=Launch
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
RENDER_BACKEND_PLAN=Starter
RENDER_FRONTEND_PLAN=Free

# BrowserStack App Automate - optional, enables real-device Autopilot smoke,
# bounded Runtime Discovery and safe autonomous suite runs. Store credentials
# as secrets in Render; never commit real values.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_HUB_URL=https://hub-cloud.browserstack.com/wd/hub
BROWSERSTACK_UPLOAD_URL=https://api-cloud.browserstack.com/app-automate/upload
BROWSERSTACK_PROJECT_NAME=QTXpert Autopilot

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
